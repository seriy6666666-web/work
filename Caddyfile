# Шифрование для доступа с планшетов и телефонов в цеху.
#
# Caddy выдаёт сертификаты сам, своим локальным центром сертификации (`issuer internal`):
# настоящий сертификат от Let's Encrypt для адреса вида 192.168.8.52 получить нельзя,
# он выдаётся только на доменные имена, доступные из интернета.
#
# Цена решения: один раз установить корневой сертификат Caddy на каждое устройство,
# иначе браузер будет пугать предупреждением. Как — в README, раздел
# «Доступ с планшетов по HTTPS».

{
	# Свои редиректы с http:// описаны ниже явно — автоматические не нужны,
	# иначе Caddy заведёт их на все адреса и они начнут конфликтовать.
	auto_https disable_redirects

	# Какой сертификат подавать, когда клиент не сообщил имя сервера.
	# При обращении по IP-адресу браузер не отправляет SNI — по стандарту там
	# допустимы только доменные имена. Без этой настройки Caddy не понимает, какой
	# из сертификатов нужен, и рукопожатие обрывается: снаружи выглядит как «сайт
	# не открывается», хотя сервер работает.
	default_sni {$SERVER_NAME:192.168.8.52}
}

# SERVER_HOST — адрес, по которому открывают систему. Задаётся в docker-compose.yml,
# несколько адресов пишутся через запятую.
#
# ВАЖНО: адрес этого ПК выдан по DHCP и может смениться после перезагрузки роутера.
# Для пилота закрепите его в роутере или задайте статический — иначе в один день
# планшеты перестанут открывать систему.
{$SERVER_HOST:https://192.168.8.52}, https://localhost {
	tls internal

	# Всё уходит на nginx фронтенда: он раздаёт интерфейс и сам проксирует
	# /api и /socket.io на бэкенд. Приложение целиком на одном источнике,
	# поэтому CORS не нужен, а наружу открыт только этот порт.
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# Кто набрал адрес без «s» — отправляем на https://, чтобы пароль не улетел
# открытым текстом просто из-за привычки.
:80 {
	redir https://{host}{uri} permanent
}
