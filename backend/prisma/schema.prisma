// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PLANNER
  PRODUCTION_HEAD
  SITE_LEAD
  WORKER
}

enum OrderStatus {
  CREATED
  IN_PROGRESS
  DONE
  SHIPPED
  /** Убран из работы, история сохранена. Удалять заказ с выработкой нельзя. */
  ARCHIVED
}

enum AbsenceType {
  SICK_LEAVE
  VACATION
  UNPAID_LEAVE
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DowntimeReasonCode {
  NO_MATERIAL
  EQUIPMENT_BREAKDOWN
  NO_ELECTRICITY
  HEALTH_ISSUE
  /** Сняли с операции и поставили на другую — решение начальника, не вина рабочего. */
  REASSIGNED
  OTHER
}

model Site {
  id                  String      @id @default(uuid())
  name                String      @unique
  createdAt           DateTime    @default(now())
  users               User[]
  operations          Operation[] @relation("OperationSite")
  secondaryOperations Operation[] @relation("OperationSecondarySite")
  transfersFrom       Transfer[]  @relation("TransferFromSite")
  transfersTo         Transfer[]  @relation("TransferToSite")
  productOperations          ProductOperation[] @relation("ProductOpSite")
  secondaryProductOperations ProductOperation[] @relation("ProductOpSecondarySite")
  equipment                  Equipment[]
  plannedShifts              PlannedShift[]
  shiftLeads                 ShiftLeadAssignment[]
  handovers                  ShiftHandover[]
  feedbacks                  Feedback[]
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  BROKEN
}

model Equipment {
  id                String          @id @default(uuid())
  name              String
  status            EquipmentStatus @default(OPERATIONAL)
  nextMaintenanceAt DateTime?
  createdAt         DateTime        @default(now())

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  /**
   * Адрес, где оборудование физически стоит. Участок и адрес — разные измерения:
   * участок призмы работает на двух адресах, поэтому одного поля «участок» мало.
   * Пусто = адрес не указан, видно всем на участке.
   */
  platform   Platform? @relation(fields: [platformId], references: [id])
  platformId String?
}

enum FeedbackType {
  PROBLEM
  IDEA
  COMPLAINT
  SHIFT
}

enum FeedbackMood {
  GOOD
  SO_SO
  BAD
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

/**
 * Обращения сотрудников на время пилота: проблемы, идеи, жалобы и отклик о смене.
 * Читает только администратор — иначе про начальника участка никто не напишет.
 */
model Feedback {
  id         String         @id @default(uuid())
  type       FeedbackType
  mood       FeedbackMood?
  message    String?
  /** С какого экрана написали — без этого «кнопка не работает» невозможно починить. */
  screen     String?
  status     FeedbackStatus @default(NEW)
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime       @default(now())

  /** Если анонимно — автора не сохраняем вовсе, остаются только роль и участок. */
  anonymous  Boolean @default(false)
  author     User?   @relation("FeedbackAuthor", fields: [authorId], references: [id])
  authorId   String?
  authorRole Role
  site       Site?   @relation(fields: [siteId], references: [id])
  siteId     String?

  repliedBy   User?   @relation("FeedbackRepliedBy", fields: [repliedById], references: [id])
  repliedById String?

  @@index([status, createdAt])
  @@index([siteId, createdAt])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role
  site         Site?    @relation(fields: [siteId], references: [id])
  siteId       String?
  createdAt    DateTime @default(now())

  /**
   * Адрес, на котором человек работает. У начальника участка это же поле решает,
   * что он видит: с адресом — только своих по этому адресу, без адреса — весь
   * участок. Так участок призмы делится на двух начальников по разным адресам,
   * а цилиндры и заготовки, живущие на одном адресе, продолжают работать как были.
   *
   * Зам начальника участка — это второй SITE_LEAD с тем же участком и адресом,
   * отдельной роли для него нет: зам нужен, чтобы подменять, значит права те же.
   */
  platform   Platform? @relation(fields: [platformId], references: [id])
  platformId String?

  /**
   * Уволенных не удаляем — за ними история производства. Архивный сотрудник не
   * входит в систему и пропадает из распределения, смен и матрицы компетенций.
   */
  archivedAt DateTime?

  /**
   * Защита от подбора пароля по конкретной учётной записи.
   *
   * Общий ограничитель стоит на 300 попыток в минуту с адреса — порог намеренно
   * высокий, потому что вся смена заходит через один заводской шлюз. Подбор к
   * одной учётной записи в этот порог укладывался целиком, поэтому считаем
   * неудачи отдельно по каждому человеку.
   */
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  assignments   Assignment[]
  competencies  Competency[]
  shifts        Shift[]
  plannedShifts PlannedShift[]
  tasks         Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreatedBy")

  // Иерархия: у сотрудника есть руководитель (для уведомлений об отсутствии).
  manager      User?  @relation("UserManager", fields: [managerId], references: [id])
  managerId    String?
  subordinates User[] @relation("UserManager")

  goals        Goal[] @relation("GoalUser")
  createdGoals Goal[] @relation("GoalCreatedBy")

  feedbacks       Feedback[] @relation("FeedbackAuthor")
  feedbackReplies Feedback[] @relation("FeedbackRepliedBy")

  shiftLeadOf   ShiftLeadAssignment[]
  handoversFrom ShiftHandover[]       @relation("HandoverFrom")
  handoversTo   ShiftHandover[]       @relation("HandoverTo")

  absences           Absence[]  @relation("AbsenceUser")
  createdAbsences    Absence[]  @relation("AbsenceCreatedBy")
  transfers          Transfer[] @relation("TransferUser")
  requestedTransfers Transfer[] @relation("TransferRequestedBy")
  respondedTransfers Transfer[] @relation("TransferRespondedBy")
  notifications      Notification[]
}

enum NotificationType {
  ASSIGNMENT
  TRANSFER_REQUEST
  TRANSFER_RESPONSE
  ORDER_DONE
  ORDER_AT_RISK
  MATERIAL_LOW
  TASK_ASSIGNED
  FEEDBACK_REPLY
  TRANSFER_INFO
  EMPLOYEE_ABSENCE
  SHIFT_HANDOVER
}

/// Персональная цель сотрудника на смену (план в штуках).
model Goal {
  id             String   @id @default(uuid())
  date           DateTime
  targetQuantity Int
  /// Причина невыполнения — заполняет начальник участка в отчёте.
  missReason     String?
  createdAt      DateTime @default(now())

  user   User   @relation("GoalUser", fields: [userId], references: [id])
  userId String

  createdBy   User   @relation("GoalCreatedBy", fields: [createdById], references: [id])
  createdById String

  @@unique([userId, date])
  @@index([date])
}

/// Старший смены — кто главный, когда начальника участка нет (например ночью).
model ShiftLeadAssignment {
  id        String    @id @default(uuid())
  date      DateTime
  type      ShiftType @default(NIGHT)
  createdAt DateTime  @default(now())

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([siteId, date, type])
  @@index([siteId, date])
}

/// Передача дел при пересменке: от старшего смены следующему, дубль начальнику производства.
model ShiftHandover {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  fromUser   User   @relation("HandoverFrom", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   User?   @relation("HandoverTo", fields: [toUserId], references: [id])
  toUserId String?

  @@index([siteId, createdAt])
}

enum TaskStatus {
  OPEN
  DONE
}

/// Личная задача руководителя: себе или подчинённому (начальнику участка/смены).
model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId String

  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String

  @@index([assigneeId, status])
}

// Каталог материалов. Остатки хранятся в разрезе площадка × проект (MaterialStock).
model Material {
  id        String   @id @default(uuid())
  name      String   @unique
  unit      String
  createdAt DateTime @default(now())

  stocks        MaterialStock[]
  techcardReqs  OperationMaterial[]
  operationReqs OperationMaterialReq[]
}

// Остаток материала в разрезе (площадка × проект). "не общее количество".
model MaterialStock {
  id                String @id @default(uuid())
  quantity          Float  @default(0)
  lowStockThreshold Float  @default(0)

  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String

  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  platformId String

  project   Product @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([materialId, platformId, projectId])
  @@index([platformId, projectId])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId, read])
}

model Absence {
  id        String      @id @default(uuid())
  type      AbsenceType
  startDate DateTime
  endDate   DateTime
  createdAt DateTime    @default(now())

  user   User   @relation("AbsenceUser", fields: [userId], references: [id])
  userId String

  createdBy       User   @relation("AbsenceCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String
}

model Transfer {
  id        String         @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  status    TransferStatus @default(PENDING)
  createdAt DateTime       @default(now())

  user   User   @relation("TransferUser", fields: [userId], references: [id])
  userId String

  fromSite   Site   @relation("TransferFromSite", fields: [fromSiteId], references: [id])
  fromSiteId String

  toSite   Site   @relation("TransferToSite", fields: [toSiteId], references: [id])
  toSiteId String

  requestedBy       User   @relation("TransferRequestedBy", fields: [requestedByUserId], references: [id])
  requestedByUserId String

  respondedBy       User?   @relation("TransferRespondedBy", fields: [respondedByUserId], references: [id])
  respondedByUserId String?
}

model Shift {
  id         String    @id @default(uuid())
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId, checkInAt])
}

enum ShiftType {
  DAY
  NIGHT
}

model PlannedShift {
  id        String    @id @default(uuid())
  date      DateTime
  type      ShiftType @default(DAY)
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  @@unique([userId, date])
  @@index([siteId, date])
}

/**
 * Навык — квалификация человека, а не работа. «Пайка», «Ручная сварка», «Гравер».
 * Отвечает на вопрос «что человек умеет» и живёт в матрице компетенций.
 *
 * Норма выработки отсюда уехала в OperationType: у навыка единой нормы быть не
 * может, пайка шин и пайка балансировочных проводов идут с разной скоростью.
 */
model Skill {
  id             String          @id @default(uuid())
  name           String          @unique
  createdAt      DateTime        @default(now())
  competencies   Competency[]
  operationTypes OperationType[]
}

/**
 * Справочник операций — что именно делают на производстве: «Пайка шин»,
 * «Сортировка ячеек», «Установка ячеек в холдер».
 *
 * Раньше операции отдельной сущностью не были: у операции заказа хранилась только
 * ссылка на навык, и в интерфейсе она называлась его именем. Из-за этого «что
 * делаем» и «что человек умеет» слились в одно, а операции без квалификации
 * создать было нельзя — навык был обязателен. На пилоте это сразу вылезло: в
 * справочнике навыков оказались «Сортировка ячеек» и «Установка ячеек в холдер»,
 * заведённые туда вынужденно.
 *
 * Справочник, а не свободный текст в каждой техкарте: иначе через полгода
 * появятся «Сортировка ячеек», «сортировка ячейки» и «Сортировка Ячеек» — три
 * разные строки об одном, и статистику по операции будет не собрать.
 */
model OperationType {
  id   String @id @default(uuid())
  name String @unique

  /** Норма выработки за смену, годных единиц. Не задана — выработку не считаем. */
  norm Float?

  /**
   * Требуемая квалификация. Необязательна: часть операций умеют все, и требовать
   * для них навык — значит заводить фиктивный навык ради одной галочки.
   */
  skill   Skill?  @relation(fields: [skillId], references: [id])
  skillId String?

  /**
   * Операции не удаляем, если они уже попали в заказы: за ними выработка людей.
   * Архивная операция пропадает из выбора, но остаётся в истории и отчётах.
   */
  archivedAt DateTime?

  createdAt         DateTime           @default(now())
  operations        Operation[]
  productOperations ProductOperation[]
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Производственная площадка (адрес/филиал). Отдельное измерение над участками.
model Platform {
  id        String          @id @default(uuid())
  name      String          @unique
  address   String?
  createdAt DateTime        @default(now())
  products  Product[]
  stocks    MaterialStock[]
  orders    Order[]
  users     User[]
  equipment Equipment[]
  operations Operation[]
}

// "Проект" в терминах заказчика: готовый шаблон изделия с техкартой (operations).
model Product {
  id         String             @id @default(uuid())
  name       String             @unique
  status     ProjectStatus      @default(ACTIVE)
  createdAt  DateTime           @default(now())
  operations ProductOperation[]
  platforms  Platform[]
  stocks     MaterialStock[]
  orders     Order[]
}

model ProductOperation {
  id       String @id @default(uuid())
  sequence Int    @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  /** Что делаем на этом шаге. Название и требуемый навык — из справочника. */
  operationType   OperationType @relation(fields: [operationTypeId], references: [id])
  operationTypeId String

  /** Сколько штук этой операции нужно на одно изделие. */
  perUnit Int @default(1)

  site   Site   @relation("ProductOpSite", fields: [siteId], references: [id])
  siteId String

  secondarySite   Site?   @relation("ProductOpSecondarySite", fields: [secondarySiteId], references: [id])
  secondarySiteId String?

  materials OperationMaterial[]
}

// Расход материала на 1 изделие для операции техкарты.
model OperationMaterial {
  id              String @id @default(uuid())
  quantityPerUnit Float

  productOperation   ProductOperation @relation(fields: [productOperationId], references: [id], onDelete: Cascade)
  productOperationId String

  material   Material @relation(fields: [materialId], references: [id])
  materialId String

  @@unique([productOperationId, materialId])
}

// Копия расхода на конкретную операцию заказа (снимок техкарты на момент создания заказа).
model OperationMaterialReq {
  id              String @id @default(uuid())
  quantityPerUnit Float

  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId String

  material   Material @relation(fields: [materialId], references: [id])
  materialId String
}

model Competency {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String

  @@unique([userId, skillId])
}

model Order {
  id         String      @id @default(uuid())
  name       String
  quantity   Int
  dueDate    DateTime
  priority   Int         @default(0)
  status     OrderStatus @default(CREATED)
  createdAt  DateTime    @default(now())
  operations Operation[]

  // Заказ привязан к проекту и площадке — чтобы знать, с какого остатка списывать.
  project   Product? @relation(fields: [projectId], references: [id])
  projectId String?

  platform   Platform? @relation(fields: [platformId], references: [id])
  platformId String?
}

model Operation {
  id       String @id @default(uuid())

  /** Объём на весь заказ — в штуках самой операции, не изделий. */
  quantity Int

  /**
   * Сколько штук этой операции приходится на одно изделие.
   *
   * Резка силового провода даёт два провода на батарею, поэтому объём операции
   * равен количеству заказа, умноженному на этот коэффициент. Он же нужен, чтобы
   * посчитать готовую продукцию: 200 нарезанных проводов — это 100 батарей.
   */
  perUnit Int @default(1)

  /**
   * Сколько участок должен сделать за смену. Ставит планировщик, считая от
   * общего объёма и срока; начальник участка уже сам решает, одним человеком
   * это закрыть или двумя.
   *
   * Не задано — план на смену не показываем, работает как раньше.
   */
  dailyQuantity Int?

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  site   Site   @relation("OperationSite", fields: [siteId], references: [id])
  siteId String

  secondarySite   Site?   @relation("OperationSecondarySite", fields: [secondarySiteId], references: [id])
  secondarySiteId String?

  /**
   * Что делаем. Название и требуемая квалификация берутся из справочника, поэтому
   * одна и та же операция называется одинаково во всех заказах.
   */
  operationType   OperationType @relation(fields: [operationTypeId], references: [id])
  operationTypeId String

  /**
   * Адрес, где операцию фактически выполняют. Материалы списываются с остатка этого
   * адреса: раньше брали адрес заказа, и если заказ оформлен на одном адресе, а
   * сделали на другом, списывался чужой склад.
   *
   * Пусто = адрес не указан, тогда берём адрес заказа, как было раньше.
   */
  platform   Platform? @relation(fields: [platformId], references: [id])
  platformId String?

  assignments  Assignment[]
  materialReqs OperationMaterialReq[]
}

model Assignment {
  id               String   @id @default(uuid())
  assignedQuantity Int?
  createdAt        DateTime @default(now())

  /**
   * День, на который выдано задание.
   *
   * Раньше даты не было вовсе: назначение висело бессрочно, доска показывала
   * вчерашние вперемешку с сегодняшними, а рабочий видел бесконечную задачу.
   * И главное — у отметки выработки лимит в два исправления, то есть на
   * многодневном назначении человек упирался в него на третий день и больше не
   * мог отчитаться. Значит, задание изначально задумывалось на смену.
   *
   * С датой начальник участка расставляет людей вперёд — на завтра и дальше, —
   * а рабочий видит только сегодняшнее.
   */
  date DateTime @db.Date

  operation   Operation @relation(fields: [operationId], references: [id])
  operationId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  completionRecords CompletionRecord[]

  /**
   * Один человек на операции — одна запись. Раньше ограничения не было, и начальник
   * участка мог назначить одного и того же сотрудника дважды: доска показывала его
   * дважды, у него появлялись две отдельные отметки выработки по одной работе, а в
   * статистике назначенный объём складывался и портил процент выполнения.
   * Менять объём нужно у существующей записи, а не добавлять вторую.
   */
  /**
   * Один человек на операции — одна запись за день. Без дня в ключе того же
   * сборщика нельзя было бы поставить на ту же операцию завтра.
   */
  @@unique([operationId, userId, date])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  username   String?
  role       Role?
  method     String
  path       String
  statusCode Int
  body       Json?
  createdAt  DateTime @default(now())
}

model CompletionRecord {
  id              String   @id @default(uuid())
  doneQuantity    Int?
  defectQuantity  Int      @default(0)
  doneFlag        Boolean?
  correctionCount Int      @default(0)
  recordedAt      DateTime @default(now())

  reasonCode      DowntimeReasonCode?
  reasonComment   String?
  reasonConfirmed Boolean             @default(false)

  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String     @unique
}
