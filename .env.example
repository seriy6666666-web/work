# Скопируйте в .env и заполните. Для локальной разработки .env не обязателен —
# значения по умолчанию из docker-compose.yml поднимут демо-стенд как есть.
#
# ДЛЯ РАБОЧЕГО ЗАПУСКА обязательны все четыре блока ниже. Без них бэкенд
# намеренно не стартует и напишет, чего не хватает.

# --- 1. База данных ---
POSTGRES_USER=belmy
POSTGRES_DB=belmy
# Свой пароль. Значение belmy_dev_password бэкенд отклонит.
POSTGRES_PASSWORD=

# --- 2. Подпись токенов ---
# Минимум 32 символа. Сгенерировать:
#   Linux/macOS:  openssl rand -base64 48
#   Windows:      powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
# При смене значения все выданные токены становятся недействительными —
# сотрудникам придётся войти заново.
JWT_SECRET=

# --- 3. Режим наполнения базы ---
# true  — демо-участки и сотрудники с паролем password123. Только для разработки и показа.
# false — демо-данных нет, создаётся только первый администратор из полей ниже.
SEED_DEMO_DATA=false

# Применяются один раз, когда в базе ещё нет ни одного администратора.
# Дальше пароль меняется через интерфейс и из этих переменных НЕ восстанавливается.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор

# --- 4. Адреса ---
# По каким именам и адресам открывают систему. Через запятую, ПРОБЕЛ ПОСЛЕ ЗАПЯТОЙ
# ОБЯЗАТЕЛЕН — без него Caddy не запускается. На каждое имя выписывается сертификат.
#
# Первым ставьте ИМЯ, а не адрес: имя не зависит от того, что выдал роутер. На
# пилоте адрес сменился шесть раз за двое суток, и каждый раз планшеты теряли
# доступ, а QR приходилось перепечатывать.
#
# Имя вида belmymes.local работает по всей сети, только если сам компьютер так и
# называется: .local раздаётся как имя компьютера. Переименование — в параметрах
# Windows, с перезагрузкой.
SERVER_HOST=https://belmymes.local, https://192.168.1.50
# Какое имя подавать, если браузер не сообщил своего: при обращении по IP он не
# сообщает его никогда.
SERVER_NAME=192.168.1.50


# Откуда браузер обращается к API. Для доступа не только с самого сервера
# укажите его адрес: http://192.168.1.50:3000 или https://belmy.example.com
VITE_API_URL=http://localhost:3000

# Каким источникам API разрешено отвечать, через запятую. Если не задать,
# API отвечает любому источнику — для рабочего запуска перечислите свои адреса.
CORS_ORIGIN=

# --- 5. Хранение журнала действий ---
# Журнал пишется на каждое изменение и на каждый отказ: он растёт всё время
# работы завода и сам не уменьшается. Раз в сутки записи старше указанного срока
# удаляются. 0 — не чистить никогда.
AUDIT_RETENTION_DAYS=365
